{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "useDefineForClassFields": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [],
    "paths": {
      "cyexcel": ["./dist/types/index.d.ts"],
      "cyexcel/core": ["./dist/types/core/index.d.ts"],
      "cyexcel/register": ["./dist/types/register.d.ts"]
    }
  },
  "include": ["tests/build/consumer-types.ts"]
}
