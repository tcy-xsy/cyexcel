{
  "name": "cyexcel",
  "version": "0.1.0",
  "description": "A framework-independent JavaScript spreadsheet component with Canvas rendering.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tcy-xsy/cyexcel.git"
  },
  "homepage": "https://tcy-xsy.github.io/cyexcel/en/",
  "bugs": {
    "url": "https://github.com/tcy-xsy/cyexcel/issues"
  },
  "keywords": [
    "spreadsheet",
    "excel",
    "canvas",
    "javascript",
    "typescript",
    "web-component"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/cyexcel.umd.cjs",
  "module": "./dist/index.js",
  "browser": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cyexcel.umd.cjs"
    },
    "./core": {
      "types": "./dist/types/core/index.d.ts",
      "import": "./dist/core.js"
    },
    "./register": {
      "types": "./dist/types/register.d.ts",
      "import": "./dist/register.js",
      "require": "./dist/cyexcel.umd.cjs"
    },
    "./formula": {
      "types": "./dist/types/formula/index.d.ts",
      "import": "./dist/formula.js"
    },
    "./toolbar": {
      "types": "./dist/types/toolbar.d.ts",
      "import": "./dist/toolbar.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "THIRD_PARTY_NOTICES.txt",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/register.js",
    "./dist/cyexcel.umd.cjs"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173",
    "docs:dev": "vite --config vite.docs.config.ts --open",
    "docs:build": "vite build --config vite.docs.config.ts && node scripts/prerender-docs.mjs",
    "docs:preview": "vite preview --config vite.docs.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run tests/unit",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:browser": "playwright test tests/browser --project=chrome",
    "test:browser:matrix": "playwright test tests/browser --project=chromium --project=firefox --project=webkit",
    "test:e2e": "playwright test tests/e2e --project=chrome",
    "test:build": "vitest run tests/build && tsc --noEmit -p tsconfig.consumer.json",
    "test:build:browser": "playwright test tests/build --project=chrome",
    "test:visual": "playwright test tests/visual --project=chrome",
    "test:perf": "playwright test tests/performance --project=chrome --workers=1",
    "test:perf:release": "CYEXCEL_PERF_MODE=release playwright test tests/performance --project=chrome --workers=1",
    "test:all": "pnpm test:unit && pnpm test:browser && pnpm test:e2e",
    "build:js": "rimraf dist && rollup -c",
    "build:types": "tsc -p tsconfig.build.json",
    "build": "pnpm build:js && pnpm build:types",
    "report:size": "node scripts/report-bundle-size.mjs",
    "api:changes": "node scripts/public-api-changes.mjs",
    "check:public-api": "node scripts/public-api-changes.mjs --check HEAD~1..HEAD",
    "check": "pnpm typecheck && pnpm lint && pnpm check:public-api && pnpm test:all && pnpm build && pnpm test:build && pnpm test:build:browser"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "fast-check": "^4.9.0",
    "globals": "^17.12.0",
    "rimraf": "^6.1.3",
    "rollup": "^4.62.4",
    "tslib": "^2.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "fast-formula-parser": "1.0.19",
    "numfmt": "3.2.6"
  }
}
